# Config for workstation-backup. Installed to /etc/workstation-backup.env
# as root-owned 0600 — it holds live credentials, keep it that way.
#
# This file is a template. The real one is never committed.

# --- Cloudflare R2 -----------------------------------------------------
# Account ID: Cloudflare dashboard > R2 > the hex string in the S3 API URL.
R2_ACCOUNT_ID=

# Bucket name, created in the R2 dashboard first.
R2_BUCKET=workstation-backups

# R2 API token, from R2 > Manage API Tokens. Needs Object Read & Write on
# the bucket above. R2 hands these out as S3-compatible key pairs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- restic ------------------------------------------------------------
# Encrypts the repository. Generate with: openssl rand -base64 32
#
# WITHOUT THIS PASSWORD THE BACKUPS CANNOT BE RESTORED. Losing it loses
# every snapshot. Store a copy somewhere off this machine — a password
# manager, not just here.
RESTIC_PASSWORD=

# --- What to back up ---------------------------------------------------
# PostgreSQL dumps and /etc server config are included automatically.
# Add application data directories here, space-separated. Paths that do not
# exist are skipped.
#
# Example: BACKUP_PATHS="/srv/app/uploads /var/lib/myapp"
BACKUP_PATHS=""

# --- Retention ---------------------------------------------------------
# How many snapshots to keep at each granularity. Defaults shown.
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=6

# Where PostgreSQL dumps are written before restic picks them up.
DUMP_DIR=/var/backups/workstation
