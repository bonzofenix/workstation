# Config for workstation-backup. Installed to /etc/workstation-backup.env
# as root-owned 0600 — it holds live credentials, keep it that way.
#
# This file is a template. The real one is never committed.

# --- Cloudflare R2 -----------------------------------------------------
# Account ID: Cloudflare dashboard > R2 > the hex string in the S3 API URL.
R2_ACCOUNT_ID=

# Bucket name, created in the R2 dashboard first.
R2_BUCKET=workstation-backups

# R2 API token, from R2 > Manage API Tokens. Needs Object Read & Write on
# the bucket above. R2 hands these out as S3-compatible key pairs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- restic ------------------------------------------------------------
# Encrypts the repository. Generate with: openssl rand -base64 32
#
# WITHOUT THIS PASSWORD THE BACKUPS CANNOT BE RESTORED. Losing it loses
# every snapshot. Store a copy somewhere off this machine — a password
# manager, not just here.
RESTIC_PASSWORD=

# --- What to back up ---------------------------------------------------
# PostgreSQL dumps (if PostgreSQL is running) and /etc server config are
# included automatically.

# SQLite databases, space-separated absolute paths.
#
# List them HERE rather than adding their directory to BACKUP_PATHS below.
# A WAL-mode SQLite database is three files (.db, .db-shm, .db-wal); copying
# them while the app is writing captures them at different moments and
# restores as a corrupt or stale database. Listing the .db here snapshots it
# through sqlite3 .backup instead, which is safe on a live database.
#
# Only the .db path is needed — the sidecars are folded into the snapshot.
#
# Example:
#   SQLITE_DATABASES="$HOME/workspace/foodtracker/data/foodtracker.db $HOME/workspace/gymtracker/data/gymtracker.db"
SQLITE_DATABASES=""

# Plain directories and files, space-separated. Paths that do not exist are
# skipped.
#
# A whole app data directory is fine here: .db, .db-wal and .db-shm files
# inside these paths are excluded automatically, so the consistent snapshots
# from SQLITE_DATABASES stay the only copy of each database. Everything else
# in the directory — CSVs, JSON, credential caches — is backed up as-is.
#
# Example: BACKUP_PATHS="$HOME/workspace/foodtracker/data /srv/app/uploads"
BACKUP_PATHS=""

# NOTE ON CREDENTIALS
#
# App data directories can hold live OAuth tokens (for example a garth/
# session cache or withings_token.json). Backing them up means the restic
# password protects those accounts too: anyone with the password and the
# bucket can use the tokens. They are usually cheap to re-authenticate, so
# excluding them costs little:
#
#   RESTIC_EXCLUDES="**/garth/** **/withings_token.json"
#
# Left empty, everything under BACKUP_PATHS is included.
RESTIC_EXCLUDES=""

# --- Retention ---------------------------------------------------------
# How many snapshots to keep at each granularity. Defaults shown.
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=6

# Where PostgreSQL dumps are written before restic picks them up.
DUMP_DIR=/var/backups/workstation
