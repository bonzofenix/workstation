# Cloudflare Tunnel config. Copy to /etc/cloudflared/config.yml and fill in.
#
# Traffic path: visitor -> Cloudflare edge -> tunnel -> localhost:80 -> Caddy
#
# Caddy keeps doing hostname routing, so this file only needs one ingress
# rule per hostname pointing at Caddy on loopback. Adding a site is a Caddy
# change plus a hostname here plus a DNS route.

# UUID printed by `cloudflared tunnel create <name>`.
tunnel: REPLACE_WITH_TUNNEL_UUID

# Written by `cloudflared tunnel create` into ~/.cloudflared/<uuid>.json.
# Move it somewhere root-owned and point at it here — the service runs as
# root and the file is a credential.
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  # One entry per hostname. All of them target Caddy on plain HTTP: TLS is
  # already terminated at the Cloudflare edge, and re-encrypting to a
  # loopback listener buys nothing.
  - hostname: example.com
    service: http://localhost:80

  - hostname: www.example.com
    service: http://localhost:80

  # Required catch-all. cloudflared refuses to start without a final rule
  # that has no hostname.
  - service: http_status:404
