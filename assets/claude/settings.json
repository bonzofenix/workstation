{
  "fileSuggestion": {
    "type": "command",
    "command": "claude-file-suggestion"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_TOOL_SEARCH": "false"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:sonarcloud.io)",
      "Bash(grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh api:*)",
      "Bash(gh pr checks:*)",
      "Bash(cf api:*)",
      "Bash(cf auth:*)",
      "Bash(flarectl dns:*)",
      "Bash(flarectl zone:*)",
      "Bash(flarectl user:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr create*)",
      "Bash(gh pr list*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(git status)",
      "Bash(pip *)",
      "Bash(trash-put:*)",
      "Bash(trash-list:*)",
      "Bash(trash:*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "MultiEdit(*)",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(*sudo*)",
      "Bash(rmdir *)"
    ]
  },
  "model": "claude-opus-5-5[1m]",
  "skillOverrides": {
    "atlassian:search-company-knowledge": "off",
    "atlassian:triage-issue": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-guard/guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-guard/guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "atlassian@claude-plugins-official": true,
    "caveman@caveman": true,
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "frontend-design@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "npmjs.org",
        "registry.npmjs.org",
        "raw.githubusercontent.com"
      ]
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Zug zug",
      "Work work",
      "Something need doing",
      "Ready to work",
      "Me busy, leave me alone",
      "Yes, me lord",
      "What you want",
      "Job's done soon",
      "Off I go then",
      "Dabu",
      "Lok'tar ogar",
      "For the Horde",
      "More work",
      "Me not that kind of orc",
      "Swobu"
    ]
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(systemctl status:*)",
      "Bash(journalctl:*)",
      "Bash(sqlite3 *.db \"SELECT*\")"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(railway down:*)",
      "Bash(railway delete:*)",
      "Bash(systemctl stop:*)",
      "Bash(systemctl restart:*)"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: [redacted]",
      "**Cloud provider(s)**: [redacted]",
      "**Repository visibility**: [redacted]",
      "**Internal sharing / snippet hosting**: [redacted]",
      "**Secrets management**: [redacted]",
      "**Default / protected branches**: [redacted]",
      "**CI/CD deploy targets**: [redacted]",
      "**Network posture**: [redacted]",
      "**Host containment**: [redacted]",
      "**Source control**: [redacted]",
      "**Trusted internal domains**: [redacted]",
      "**Trusted cloud buckets**: [redacted]",
      "**Key internal services**: [redacted]",
      "**Internal package registry**: [redacted]",
      "**Sensitive data locations & audiences**: [redacted]",
      "**Data retention / declassification**: [redacted]",
      "**Sensitive remote targets**: [redacted]",
      "**Protected deployment namespaces / environments**: [redacted]",
      "**Protected IaC scopes**: [redacted]",
      "### User-specific",
      "**Primary use of Claude Code**: [redacted]",
      "**Trusted repo**: [redacted]",
      "**Org-specific CLiIs**: [redacted]",
      "**Routine under bonzofenix/app1 prefix**: [redacted]"
    ]
  },
  "voiceEnabled": true,
  "defaultMode": "plan",
  "gitAttribution": false,
  "keybindings": {
    "sendToBackground": "ctrl+g ctrl+g"
  }
}
