{
  "fileSuggestion": {
    "type": "command",
    "command": "claude-file-suggestion"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_TOOL_SEARCH": "false"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:sonarcloud.io)",
      "Bash(grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh api:*)",
      "Bash(gh pr checks:*)",
      "Bash(cf api:*)",
      "Bash(cf auth:*)",
      "Bash(flarectl dns:*)",
      "Bash(flarectl zone:*)",
      "Bash(flarectl user:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr create*)",
      "Bash(gh pr list*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(git status)",
      "Bash(pip *)",
      "Bash(trash-put:*)",
      "Bash(trash-list:*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "MultiEdit(*)",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(*sudo*)"
    ]
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "atlassian:search-company-knowledge": "off",
    "atlassian:triage-issue": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-guard/guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "for d in $HOME/workspace/skills/*/; do name=$(basename \"$d\"); mkdir -p \"$HOME/.claude/skills/$name\"; cp \"$d/SKILL.md\" \"$HOME/.claude/skills/$name/skill.md\" 2>/dev/null || true; done",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "atlassian@claude-plugins-official": true,
    "caveman@caveman": true,
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "frontend-design@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "npmjs.org",
        "registry.npmjs.org",
        "raw.githubusercontent.com"
      ]
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Zug zug",
      "Work work",
      "Something need doing",
      "Ready to work",
      "Me busy, leave me alone",
      "Yes, me lord",
      "What you want",
      "Job's done soon",
      "Off I go then",
      "Dabu",
      "Lok'tar ogar",
      "For the Horde",
      "More work",
      "Me not that kind of orc",
      "Swobu"
    ]
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(systemctl status:*)",
      "Bash(journalctl:*)",
      "Bash(sqlite3 *.db \"SELECT*\")"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(railway down:*)",
      "Bash(railway delete:*)",
      "Bash(systemctl stop:*)",
      "Bash(systemctl restart:*)"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Not queryable via gh (remote uses a custom SSH host alias `github-foodtracker`, not a plain owner/repo URL); assume private per shipped default",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: `.env` files (gitignored, `.env.example` tracked); CI secret `GITHUB_TOKEN` referenced in workflows",
      "**Default / protected branches**: main (default); protection status not queryable via gh for this remote",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (bonzofenix/foodtracker, via origin remote aliased as github-foodtracker) and its remote(s) only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: `.env` files and `deploy/.env.example` (credentials/config); personal health data in the SQLite DB (`DATA_DIR`/`DB_PATH`) — food log, weight, body-fat, sleep, steps, InBody/Garmin/Withings data — share only with the repo owner",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (personal health-tracking project, foodtracker)",
      "**Trusted repo**: bonzofenix/foodtracker (this repo, working directory and its origin remote)",
      "**Org-specific CLiIs**: None configured — routine use of `railway`, `systemctl`, `journalctl`, `sqlite3`, `gh` observed in this project",
      "**Routine under bonzofenix/foodtracker prefix**: gh pr list/view, systemctl and journalctl status checks, sqlite3 inspection of the local DB"
    ]
  },
  "voiceEnabled": true,
  "defaultMode": "plan",
  "gitAttribution": false,
  "keybindings": {
    "sendToBackground": "ctrl+g ctrl+g"
  }
}
