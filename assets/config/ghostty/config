# Ghostty Terminal Configuration

# Font configuration
font-family = "JetBrains Mono"
font-size = 13

# Theme
theme = dark:Catppuccin Frappe,light:Catppuccin Latte

# Window configuration
window-padding-x = 8
window-padding-y = 8

# Cursor
cursor-style = block
cursor-style-blink = false

# Mouse
mouse-hide-while-typing = true

# Bell: Claude Code rings it (peon-ping hook) when a session finishes or needs
# input, on this Mac or on any host reached over ssh. Bounce the dock icon and
# mark the tab title with 🔔. The sound comes from tmux (alert-bell hook in
# assets/tmux.conf): audio here stayed silent on 1.3.1, and enabling it too
# would play the chime twice if it ever starts working.
bell-features = no-audio,attention,title

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Keybindings
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+n=new_window
keybind = super+t=new_tab
keybind = super+w=close_surface

# macOS specific
macos-titlebar-style = tabs
macos-option-as-alt = true
