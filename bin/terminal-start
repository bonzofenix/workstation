#!/usr/bin/env bash

# Pick where a new terminal opens: local tmux, or a host from ~/.ssh/config.
# ~/.zprofile runs this in interactive login shells outside tmux.
#
#   local        tmux session `base` on this machine
#   <host>       ssh to it and attach its tmux session `main` (the session
#                lib/linux-configurations.sh auto-attaches on ssh login), or a
#                login shell when the host has no tmux
#   Esc/Ctrl-C   plain local shell, no tmux
#
# Detaching or leaving ssh drops back to the local shell, as before.
#
# Hosts come from ~/.ssh/config so no hostnames live in this public repo:
# every literal `Host` alias, skipping patterns (*, ?, !) and dotted names
# (github.com and other service aliases). `Include`d files are not read.
# Without gum or any host it goes straight to local tmux.

set -uo pipefail

tmux_bin="$(command -v tmux || echo "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/tmux")"

ssh_hosts() {
  [[ -r ~/.ssh/config ]] || return 0
  awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) { if ($i ~ /^#/) break; if ($i !~ /[*?!.]/ && !seen[$i]++) print $i } }' ~/.ssh/config
}

hosts="$(ssh_hosts)"
if [[ -z "$hosts" ]] || ! command -v gum >/dev/null; then
  exec "$tmux_bin" new -As base
fi

choice="$(printf 'local\n%s\n' "$hosts" | gum choose --header "Open terminal on")" || exit 0

[[ "$choice" == local ]] && exec "$tmux_bin" new -As base

# Run the remote side in a login shell so its profile puts a Homebrew or
# ~/.local tmux on PATH; sshd's command PATH alone misses those. The profile's
# own tmux/picker autostart is guarded on interactive shells, so -lc skips it.
# shellcheck disable=SC2016 # $SHELL expands on the remote
remote_cmd='command -v tmux >/dev/null && exec tmux new -As main || exec "$SHELL" -l'
# Most remotes lack terminfo for Ghostty's TERM, and tmux refuses to start.
[[ "${TERM:-}" == xterm-ghostty ]] && export TERM=xterm-256color
exec ssh -t -o ConnectTimeout=5 "$choice" "exec \"\$SHELL\" -lc $(printf '%q' "$remote_cmd")"
