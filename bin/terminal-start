#!/usr/bin/env bash

# Pick where a new terminal opens: local tmux, or a host from ~/.ssh/config.
# ~/.zprofile runs this in interactive login shells outside tmux.
#
#   local        tmux session `base` on this machine
#   <host>       ssh to it and attach its tmux session `main` (the session
#                lib/linux-configurations.sh auto-attaches on ssh login), or a
#                login shell when the host has no tmux
#   Esc/Ctrl-C   plain local shell, no tmux
#
# Detaching or leaving ssh drops back to the local shell.
#
# Hosts come from ~/.ssh/config so no hostnames live in this public repo:
# every literal `Host` alias, skipping patterns (*, ?, !), dotted names
# (github.com and other service aliases) and names starting with `-`.
# `Include`d files are not read. Without gum, a terminal or any host it goes
# straight to local tmux.

set -uo pipefail

warn() { echo "terminal-start: $*" >&2; }

local_tmux() {
  local tmux_bin
  tmux_bin="$(command -v tmux || echo "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/tmux")"
  if [[ ! -x "$tmux_bin" ]]; then
    warn "tmux not found (PATH or $tmux_bin); plain shell"
    exit 0
  fi
  exec "$tmux_bin" new -As base
}

# Accepts `Host a b`, `Host = a` and `Host=a`, strips quotes and stops at a
# trailing comment. HostName and other Host* keywords do not match.
ssh_hosts() {
  [[ -r ~/.ssh/config ]] || return 0
  awk '
    { line = $0; sub(/^[ \t]+/, "", line) }
    tolower(substr(line, 1, 4)) == "host" && substr(line, 5, 1) ~ /[ \t=]/ {
      n = split(substr(line, 5), names, /[ \t=]+/)
      for (i = 1; i <= n; i++) {
        name = names[i]; gsub(/"/, "", name)
        if (name ~ /^#/) break
        if (name != "" && name !~ /^-|[*?!.]/ && !seen[name]++) print name
      }
    }' ~/.ssh/config
}

hosts="$(ssh_hosts)"
if [[ -z "$hosts" ]] || ! command -v gum >/dev/null || [[ ! -t 0 || ! -t 1 ]]; then
  local_tmux
fi

choice="$(printf 'local\n%s\n' "$hosts" | gum choose --header "Open terminal on")"
gum_status=$?
case "$gum_status" in
  0)     ;;
  1|130) exit 0 ;;  # Esc / Ctrl-C: plain shell
  *)     warn "gum failed (exit $gum_status); opening local tmux"; local_tmux ;;
esac

[[ "$choice" == local ]] && local_tmux

# Run the remote side in a login shell so its profile puts a Homebrew or
# ~/.local tmux on PATH; sshd's command PATH alone misses those. The profile's
# own tmux/picker autostart is guarded on interactive shells, so -lc skips it.
# shellcheck disable=SC2016 # $SHELL expands on the remote
remote_cmd='command -v tmux >/dev/null && exec tmux new -As main || { echo "terminal-start: no tmux on this host; plain shell" >&2; exec "$SHELL" -l; }'
# Most remotes lack terminfo for Ghostty's TERM, and tmux refuses to start.
[[ "${TERM:-}" == xterm-ghostty ]] && export TERM=xterm-256color
exec ssh -t -o ConnectTimeout=5 -- "$choice" "exec \"\$SHELL\" -lc $(printf '%q' "$remote_cmd")"
