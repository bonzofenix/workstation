#!/usr/bin/env bash

# Helper script to run shellcheck on workstation scripts

set -euo pipefail

echo "Running shellcheck on all workstation scripts..."
echo ""

# Count issues by severity
errors=0
warnings=0
info=0

# Run shellcheck on all bin and lib scripts
while IFS= read -r script; do
  if [[ -f "$script" ]]; then
    # Only sh-family scripts can be parsed by this linter; zsh, python and
    # other interpreters get SC1071 for the whole file. Skip them rather than
    # carry a permanent error that means "not analyzed" — it would mask real
    # errors in everything else. Files without a shebang (sourced *.sh
    # libraries) are still linted.
    first_line="$(head -1 "$script")"
    if [[ "$first_line" == '#!'* ]] && ! grep -qE '(^#!.*[/ ](ba|da|k)?sh)([[:space:]]|$)' <<< "$first_line"; then
      continue
    fi

    output=$(shellcheck "$script" 2>&1 || true)

    if [[ -n "$output" ]]; then
      echo "$output"
      echo ""

      # Count by severity.
      #
      # Match shellcheck's own "(error):" tag rather than the bare word: the
      # footer it prints links to shellcheck.net/wiki/SCxxxx and the message
      # prose uses these words too, so counting bare words overcounts.
      #
      # `|| true` on the pipeline, not `|| echo "0"` inside the expansion:
      # grep -c already prints 0 when it matches nothing, and also exits 1,
      # so the old fallback appended a second line. The result was "0\n0",
      # which made the arithmetic a syntax error and left every counter
      # pinned at 0 — the whole summary, and the exit status CI reads.
      errors=$((errors + $(grep -c '(error):' <<< "$output" || true)))
      warnings=$((warnings + $(grep -c '(warning):' <<< "$output" || true)))
      info=$((info + $(grep -c '(info):' <<< "$output" || true)))
    fi
  fi
done < <(find bin lib -type f \( -name "*.sh" -o -executable \) 2>/dev/null)

# Public-safety checks. This repo is public; private content belongs in the
# private memory repo. These run in CI, so they can only check structure — the
# denylist of private strings lives in that private repo and is enforced by the
# pre-commit hook (bin/leak-check) instead.
#
# ~/.claude/settings.json is a symlink into this repo, so anything Claude Code
# writes there (such as an auto-mode environment describing a private project)
# lands in a tracked file. That is how such a block got published once.
settings_rc=0
python3 - assets/claude/settings.json <<'PY' || settings_rc=$?
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception as e:
    print(f"{sys.argv[1]}: {e}")
    sys.exit(2)
sys.exit(3 if "environment" in d.get("autoMode", {}) else 0)
PY
case "$settings_rc" in
  0) ;;
  3)
    echo "assets/claude/settings.json: autoMode.environment (error): per-project context; move it to that project's .claude/settings.local.json"
    errors=$((errors + 1)) ;;
  *)
    echo "assets/claude/settings.json: not valid JSON (error)"
    errors=$((errors + 1)) ;;
esac
if [[ -e assets/claude/memory ]]; then
  echo "assets/claude/memory (error): memory is private; it lives in the memory repo"
  errors=$((errors + 1))
fi

echo "================================"
echo "Summary:"
echo "  Errors:   $errors"
echo "  Warnings: $warnings"
echo "  Info:     $info"
echo "================================"

if [[ $errors -gt 0 ]]; then
  exit 1
fi

exit 0
