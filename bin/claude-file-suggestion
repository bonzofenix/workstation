#!/usr/bin/env bash
# Case-insensitive file suggestion for Claude Code `@` mentions.
#
# Claude Code invokes this with the partial query as $1 and expects a
# newline-separated list of matching file paths on stdout. The default
# built-in matcher is case-sensitive; this fold-cases both the query and
# the candidate paths so `@trading` finds `Trading MOC.md`.
#
# Wired via settings.json:
#   "fileSuggestion": { "type": "command", "command": "claude-file-suggestion" }

set -euo pipefail

query="${1:-}"
root="${CLAUDE_PROJECT_DIR:-$PWD}"
limit=50

cd "$root" 2>/dev/null || exit 0

# List candidate files. Prefer git (respects .gitignore, fast); fall back to find.
list_files() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git ls-files --cached --others --exclude-standard
  else
    find . -type f \
      -not -path '*/.git/*' \
      -not -path '*/node_modules/*' \
      -not -path '*/.obsidian/*' \
      | sed 's|^\./||'
  fi
}

# Empty query: return first N files.
if [[ -z "$query" ]]; then
  list_files | head -n "$limit"
  exit 0
fi

# Case-insensitive substring match, ranked: basename hits before path hits.
q_lower="$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')"

list_files | awk -v q="$q_lower" -v lim="$limit" '
  {
    path = $0
    lower = tolower(path)
    if (index(lower, q) == 0) next

    n = split(path, parts, "/")
    base = tolower(parts[n])

    # Rank 0 = query matches basename, Rank 1 = matches elsewhere in path.
    rank = (index(base, q) > 0) ? 0 : 1
    printf "%d\t%s\n", rank, path
  }
' | sort -t $'\t' -k1,1n -k2,2 | cut -f2- | head -n "$limit"
